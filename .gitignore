              <p class="mt-1 text-sm muted text-[var(--color-muted)]">Search, segment, sort and manage your complete student database.</p>
            </div>
            <div class="flex flex-wrap gap-2"><button id="importButton" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold soft">📥 Import CSV</button><input id="importFile" type="file" accept=".csv" class="hidden"><button id="clear" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold muted soft text-[var(--color-muted)]">Reset filters</button></div>
          </div>
          <div class="grid gap-3 p-5 md:grid-cols-2 xl:grid-cols-5"><input id="search" class="soft rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none" placeholder="Search name, ID or email..."><select id="department" class="soft rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none">
              <option value="">All departments</option>
              <option>Computer Science</option>
              <option>AI & ML</option>
              <option>Electronics</option>
              <option>Mechanical</option>
              <option>Civil</option>
            </select><select id="year" class="soft rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none">
              <option value="">All years</option>
              <option value="1">Year 1</option>
              <option value="2">Year 2</option>
              <option value="3">Year 3</option>
              <option value="4">Year 4</option>
            </select><input id="minCgpa" type="number" min="0" max="10" step="0.1" class="soft rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none" placeholder="Min CGPA"><input id="maxCgpa" type="number" min="0" max="10" step="0.1" class="soft rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none" placeholder="Max CGPA"></div>
          <div id="status" class="hidden mx-5 mb-4 rounded-xl bg-red-50 p-4 text-sm text-red-700"></div>
          <div id="loading" class="hidden p-12 text-center text-sm muted text-[var(--color-muted)]">Loading live student records…</div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[1050px] text-left text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wider muted text-[var(--color-muted)]">
                <tr>
                  <th class="px-6 py-4">ID</th>
                  <th class="px-4 py-4">Student</th>
                  <th class="px-4 py-4">Register number</th>
                  <th class="px-4 py-4">Department</th>
                  <th class="px-4 py-4">Year</th>
                  <th class="px-4 py-4">CGPA</th>
                  <th class="px-4 py-4">Attendance</th>
                  <th class="px-4 py-4">Actions</th>
                </tr>
              </thead>
              <tbody id="table"></tbody>
            </table>
          </div>
          <div id="empty" class="hidden p-16 text-center">
            <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full bg-violet-100 text-2xl text-violet-600">◈</div>
            <h3 class="text-lg font-bold">Your directory is ready</h3>
            <p class="mx-auto mt-2 max-w-sm text-sm muted text-[var(--color-muted)]">No students match these filters yet. Add the first record to begin.</p><button id="emptyAdd" class="mt-5 rounded-xl bg-[var(--color-primary)] px-5 py-3 text-sm font-bold text-white">Add first student</button>
          </div>
          <div class="flex items-center justify-between border-t border-slate-100 p-5 text-sm"><span id="pageInfo" class="muted text-[var(--color-muted)]">Showing 0 students</span>
            <div class="flex gap-2"><button id="prev" class="rounded-lg border border-slate-200 px-3 py-2 soft">←</button><button id="next" class="rounded-lg border border-slate-200 px-3 py-2 soft">→</button></div>
          </div>
        </section>
        <section id="activity" class="light-card rounded-[var(--radius)] bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold">Recent activity</h2>
              <p class="mt-1 text-sm muted text-[var(--color-muted)]">A transparent operational history.</p>
            </div><span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700">Audit trail</span>
          </div>
          <div id="activityList" class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-4"></div>
        </section>
      </div>
    </main>
  </div>
  <div id="modal" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="modal-card w-full max-w-2xl rounded-[var(--radius)] bg-white p-7 shadow-2xl">
      <div class="mb-6 flex items-start justify-between">
        <div>
          <div class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)]">Directory record</div>
          <h2 id="modalTitle" class="mt-1 text-2xl font-bold">Add student</h2>
        </div><button id="close" class="text-2xl text-slate-400">×</button>
      </div>
      <div id="formError" class="mb-4 hidden rounded-xl bg-red-50 p-3 text-sm text-red-700"></div>
      <form id="form" class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold">Full name<input name="name" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"></label><label class="text-sm font-semibold">Register number<input name="register_number" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"></label><label class="text-sm font-semibold">Email<input name="email" type="email" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"></label><label class="text-sm font-semibold">Phone<input name="phone" required pattern="[+0-9 ()-]{7,20}" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"></label><label class="text-sm font-semibold">Department<select name="department" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3">
            <option value="">Choose department</option>
            <option>Computer Science</option>
            <option>AI & ML</option>
            <option>Electronics</option>
            <option>Mechanical</option>
            <option>Civil</option>
          </select></label><label class="text-sm font-semibold">Year<select name="year" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3">
            <option value="">Choose year</option>
            <option value="1">Year 1</option>
            <option value="2">Year 2</option>
            <option value="3">Year 3</option>
            <option value="4">Year 4</option>
          </select></label><label class="text-sm font-semibold sm:col-span-2">CGPA<input name="cgpa" type="number" min="0" max="10" step="0.01" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"></label>
        <div class="flex justify-end gap-3 sm:col-span-2"><button type="button" id="cancel" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold">Cancel</button><button class="rounded-xl bg-[var(--color-primary)] px-5 py-3 text-sm font-bold text-white" type="submit">Save record</button></div>
      </form>
    </div>
  </div>
  <div id="importModal" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto p-4">
    <div class="modal-card w-full max-w-4xl rounded-[var(--radius)] bg-white p-6 shadow-2xl md:p-8">
      <div class="mb-6 flex items-start justify-between">
        <div>
          <div class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)]">Bulk data workflow</div>
          <h2 class="mt-1 text-2xl font-bold">Import Students from CSV</h2>
          <p class="mt-2 text-sm text-[var(--color-muted)]">Validate your records before they reach the student directory.</p>
        </div>
        <button id="closeImport" class="text-2xl text-slate-400" aria-label="Close import dialog">×</button>
      </div>
      <div id="dropZone" class="cursor-pointer rounded-[var(--radius)] border-2 border-dashed border-violet-200 bg-violet-50/60 p-8 text-center transition hover:border-violet-400">
        <div class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-2xl bg-white text-2xl shadow-sm">📄</div>
        <p class="font-bold">Drop CSV file here</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">or click to browse</p>
        <p id="selectedFile" class="mt-3 text-xs font-semibold text-[var(--color-primary)]">Supported format: .csv · Maximum file size: 5 MB</p>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <button id="templateButton" class="text-sm font-bold text-[var(--color-primary)]">↓ Download CSV Template</button>
        <div id="importMessage" class="hidden rounded-xl px-4 py-2 text-sm font-semibold"></div>
      </div>
      <div id="previewPanel" class="mt-6 hidden">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div><h3 class="text-lg font-bold">Import Preview</h3><p id="previewCount" class="mt-1 text-sm text-[var(--color-muted)]"></p></div>
          <div class="flex gap-2 text-xs font-bold"><span class="rounded-full bg-emerald-100 px-3 py-2 text-emerald-700">Valid: <b id="validCount">0</b></span><span class="rounded-full bg-red-100 px-3 py-2 text-red-700">Invalid: <b id="invalidCount">0</b></span><span class="rounded-full bg-amber-100 px-3 py-2 text-amber-700">Duplicates: <b id="duplicateCount">0</b></span></div>
        </div>
        <div class="max-h-64 overflow-auto rounded-xl border border-slate-100"><table class="w-full min-w-[650px] text-left text-sm"><thead class="sticky top-0 bg-slate-50 text-xs uppercase tracking-wider text-[var(--color-muted)]"><tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">Register No.</th><th class="px-4 py-3">Department</th><th class="px-4 py-3">Year</th><th class="px-4 py-3">CGPA</th><th class="px-4 py-3">Status</th></tr></thead><tbody id="previewTable"></tbody></table></div>
        <div id="importProgress" class="mt-4 hidden"><div class="flex justify-between text-xs font-bold"><span>Importing students...</span><span>Please wait...</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full w-2/3 animate-pulse rounded-full bg-[var(--color-primary)]"></div></div></div>
        <div class="mt-6 flex justify-end gap-3"><button id="cancelImport" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold">Cancel</button><button id="confirmImport" class="rounded-xl bg-[var(--color-primary)] px-5 py-3 text-sm font-bold text-white disabled:opacity-50" disabled>Import Students</button></div>
      </div>
    </div>
  </div>
  <div id="toast" class="fixed bottom-6 right-6 z-[60] hidden rounded-xl bg-slate-900 px-5 py-4 text-sm font-semibold text-white shadow-xl"></div>
  <script src="/js/app.js"></script>
  <script src="/js/import.js"></script>
</body>

</html>
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
