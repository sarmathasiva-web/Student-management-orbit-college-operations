            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold">Student analytics</h2>
                <p class="mt-1 text-sm muted text-[var(--color-muted)]">Distribution across departments and academic bands.</p>
              </div><span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700">Live</span>
            </div>
