          <div class="absolute -bottom-40 right-24 h-72 w-72 rounded-full border-[35px] border-white/10"></div>
        </section>
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <div class="light-card rounded-[var(--radius)] bg-white p-5 shadow-sm">
            <div class="mb-5 flex justify-between text-sm muted text-[var(--color-muted)]"><span>Total students</span><span>✦</span></div>
