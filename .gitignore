const IMPORT_COLUMNS = ['name', 'register_number', 'email', 'phone', 'department', 'year', 'cgpa'];
let importFile = null;
let importRows = [];

function openImportModal() {
  $('importModal').classList.remove('hidden');
  $('importModal').classList.add('flex');
}

function closeImportModal() {
  $('importModal').classList.add('hidden');
  $('importModal').classList.remove('flex');
  resetImport();
}

function resetImport() {
  importFile = null;
  importRows = [];
  $('importFile').value = '';
  $('selectedFile').textContent = 'Supported format: .csv · Maximum file size: 5 MB';
  $('previewPanel').classList.add('hidden');
  $('importMessage').className = 'hidden rounded-xl px-4 py-2 text-sm font-semibold';
  $('confirmImport').disabled = true;
  $('previewTable').innerHTML = '';
}

function showImportMessage(message, error = true) {
  const box = $('importMessage');
  box.textContent = message;
  box.className = `rounded-xl px-4 py-2 text-sm font-semibold ${error ? 'bg-red-50 text-red-700' : 'bg-emerald-50 text-emerald-700'}`;
}

function parseCsv(text) {
  const rows = [];
  let row = [];
  let value = '';
  let quoted = false;
  for (let index = 0; index < text.length; index += 1) {
    const character = text[index];
    const next = text[index + 1];
    if (character === '"' && quoted && next === '"') {
      value += '"';
      index += 1;
    } else if (character === '"') {
      quoted = !quoted;
    } else if (character === ',' && !quoted) {
      row.push(value.trim());
      value = '';
    } else if ((character === '\n' || character === '\r') && !quoted) {
      if (character === '\r' && next === '\n') index += 1;
      row.push(value.trim());
      if (row.some(cell => cell !== '')) rows.push(row);
      row = [];
      value = '';
    } else {
      value += character;
    }
  }
  if (value || row.length) {
    row.push(value.trim());
    if (row.some(cell => cell !== '')) rows.push(row);
  }
  if (quoted) throw new Error('The CSV contains an unfinished quoted value.');
  return rows;
}

function validateImportRow(row, index, seenRegisters, seenEmails) {
  const errors = [];
  IMPORT_COLUMNS.forEach(field => {
    if (!row[field]) errors.push(`${field} is required.`);
  });
  if (row.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(row.email)) errors.push('Enter a valid email address.');
  if (row.phone && !/^\+?[0-9 ()-]{7,20}$/.test(row.phone)) errors.push('Enter a valid phone number.');
  if (row.year && ![1, 2, 3, 4].includes(Number(row.year))) errors.push('Year must be between 1 and 4.');
  if (row.cgpa && (Number.isNaN(Number(row.cgpa)) || Number(row.cgpa) < 0 || Number(row.cgpa) > 10)) errors.push('CGPA must be between 0 and 10.');
  const register = row.register_number.toLowerCase();
  const email = row.email.toLowerCase();
  if (register && seenRegisters.has(register)) errors.push(`Duplicate register number: ${row.register_number}`);
  if (email && seenEmails.has(email)) errors.push(`Duplicate email: ${row.email}`);
  if (register && students.some(student => student.register_number.toLowerCase() === register)) errors.push(`Duplicate register number: ${row.register_number}`);
  if (email && students.some(student => student.email.toLowerCase() === email)) errors.push(`Duplicate email: ${row.email}`);
  return [...new Set(errors)];
}

async function inspectImportFile(file) {
  if (!file) return;
  if (!file.name.toLowerCase().endsWith('.csv')) return showImportMessage('Only .csv files are supported.');
  if (!file.size) return showImportMessage('CSV file is empty.');
  if (file.size > 5 * 1024 * 1024) return showImportMessage('CSV file must be 5 MB or smaller.');
  try {
    const rows = parseCsv(await file.text());
    if (rows.length < 2) return showImportMessage('CSV file is empty.');
    const headers = rows.shift().map(header => header.trim().toLowerCase());
    const missing = IMPORT_COLUMNS.filter(column => !headers.includes(column));
    if (missing.length) return showImportMessage(`Invalid CSV format. Missing required column: ${missing[0]}`);
    importRows = rows.map(values => Object.fromEntries(IMPORT_COLUMNS.map(column => [column, (values[headers.indexOf(column)] || '').trim()])));
    importFile = file;
    $('selectedFile').textContent = `${file.name} · ${importRows.length} records ready for review`;
    renderImportPreview();
  } catch (error) {
    showImportMessage(error.message || 'Unable to read this CSV file.');
  }
}

function renderImportPreview() {
  const registers = new Set();
  const emails = new Set();
  let valid = 0;
  let invalid = 0;
  let duplicates = 0;
  $('previewTable').innerHTML = importRows.slice(0, 100).map((row, index) => {
    const errors = validateImportRow(row, index, registers, emails);
    const duplicate = errors.some(error => error.toLowerCase().includes('duplicate'));
    registers.add(row.register_number.toLowerCase());
    emails.add(row.email.toLowerCase());
    if (errors.length) invalid += 1;
    else valid += 1;
    if (duplicate) duplicates += 1;
    const status = errors.length ? duplicate ? 'Duplicate' : 'Review' : 'Valid';
    const style = errors.length ? duplicate ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700';
    return `<tr class="border-t border-slate-100"><td class="px-4 py-3 font-semibold">${safe(row.name)}</td><td class="px-4 py-3">${safe(row.register_number)}</td><td class="px-4 py-3">${safe(row.department)}</td><td class="px-4 py-3">${safe(row.year)}</td><td class="px-4 py-3 font-bold">${safe(row.cgpa)}</td><td class="px-4 py-3"><span title="${safe(errors.join(' '))}" class="rounded-full px-2 py-1 text-xs font-bold ${style}">${status}</span></td></tr>`;
  }).join('');
  $('previewPanel').classList.remove('hidden');
  $('previewCount').textContent = `${importRows.length} records found${importRows.length > 100 ? ' · showing first 100' : ''}`;
  $('validCount').textContent = valid;
  $('invalidCount').textContent = invalid;
  $('duplicateCount').textContent = duplicates;
  $('confirmImport').disabled = !importFile || valid === 0;
}

async function submitImport() {
  if (!importFile) return;
  const button = $('confirmImport');
  button.disabled = true;
  $('importProgress').classList.remove('hidden');
  await new Promise(resolve => setTimeout(resolve, 250));
  try {
    const registers = new Set();
    const emails = new Set();
    const validRows = importRows.filter((row, index) => {
      const errors = validateImportRow(row, index, registers, emails);
      if (!errors.length) {
        registers.add(row.register_number.toLowerCase());
        emails.add(row.email.toLowerCase());
        return true;
      }
      return false;
    });
    validRows.forEach(row => students.unshift({
      ...row,
      id: nextId(),
      year: Number(row.year),
      cgpa: Number(row.cgpa),
      attendance: {
        present: 0,
        absent: 0,
        percentage: 0
      },
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    }));
    if (!validRows.length) throw new Error('No valid records were available for import.');
    addActivity('CSV imported', `Imported ${validRows.length} students from ${importFile.name}`);
    refreshDashboard();
    closeImportModal();
    showToast(`✓ Import completed successfully. ${validRows.length} students imported.`);
  } catch (error) {
    showImportMessage(error.message || 'Unable to import this CSV file.');
  } finally {
    $('importProgress').classList.add('hidden');
    if ($('importModal').classList.contains('flex')) button.disabled = false;
  }
}

function downloadTemplate() {
  const link = document.createElement('a');
  link.href = URL.createObjectURL(new Blob([`${IMPORT_COLUMNS.join(',')}\n`], {
    type: 'text/csv;charset=utf-8'
  }));
  link.download = 'student_template.csv';
  link.click();
  URL.revokeObjectURL(link.href);
}

$('importButton').onclick = openImportModal;
$('importSide').onclick = openImportModal;
$('heroImportButton').onclick = openImportModal;
$('closeImport').onclick = closeImportModal;
$('cancelImport').onclick = closeImportModal;
$('templateButton').onclick = downloadTemplate;
$('dropZone').onclick = () => $('importFile').click();
$('importFile').onchange = event => inspectImportFile(event.target.files[0]);
$('dropZone').ondragover = event => {
  event.preventDefault();
  $('dropZone').classList.add('border-violet-500');
};
$('dropZone').ondragleave = () => $('dropZone').classList.remove('border-violet-500');
$('dropZone').ondrop = event => {
  event.preventDefault();
  $('dropZone').classList.remove('border-violet-500');
  inspectImportFile(event.dataTransfer.files[0]);
};
$('confirmImport').onclick = submitImport;
<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orbit | College Operations</title>
  <link rel="stylesheet" href="/theme.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    h1,
    h2,
    h3,
    h4 {
      font-family: var(--font-heading);
    }

    .nav-active {
      background: color-mix(in srgb, var(--color-primary) 13%, transparent);
      color: var(--color-primary);
    }

    .glass {
      background: color-mix(in srgb, var(--color-surface) 88%, transparent);
      backdrop-filter: blur(18px);
    }

    .modal-backdrop {
      background: rgba(8, 15, 31, .62);
      backdrop-filter: blur(8px);
    }

    .dark body {
      background: #0b1220;
      color: #edf2ff;
    }

    .dark .light-card,
    .dark header,
    .dark aside,
    .dark .modal-card {
      background: #111a2c;
      border-color: #26334c;
    }

    .dark .soft {
      background: #172238;
      border-color: #2b3954;
    }

    .dark .muted {
      color: #98a8c4;
    }

    .dark table thead {
      background: #172238;
    }

  </style>
</head>

<body>
  <div class="min-h-screen lg:flex">
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-72 -translate-x-full border-r border-slate-200 bg-white p-6 transition-transform lg:static lg:translate-x-0">
      <div class="mb-10 flex items-center gap-3">
        <div class="grid h-11 w-11 place-items-center rounded-[var(--radius)] bg-[var(--color-primary)] text-xl font-bold text-white">O</div>
        <div>
          <div class="text-lg font-bold tracking-tight">Orbit</div>
          <div class="text-xs muted text-[var(--color-muted)]">College operations</div>
        </div>
      </div>
      <div class="mb-4 text-xs font-bold uppercase tracking-widest muted text-[var(--color-muted)]">Workspace</div>
      <nav class="space-y-2">
        <a class="nav-active flex items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-sm font-semibold" href="#dashboard">⌂ <span>Dashboard</span></a>
        <a class="flex items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-sm font-semibold muted text-[var(--color-muted)] hover:bg-slate-50" href="#students">◈ <span>Students</span></a>
        <button id="addSide" class="flex w-full items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-left text-sm font-semibold muted text-[var(--color-muted)] hover:bg-slate-50">＋ <span>Add student</span></button>
        <button id="importSide" class="flex w-full items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-left text-sm font-semibold muted text-[var(--color-muted)] hover:bg-slate-50">⇧ <span>Import students</span></button>
        <a class="flex items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-sm font-semibold muted text-[var(--color-muted)] hover:bg-slate-50" href="#insights">◒ <span>Insights</span></a>
        <a class="flex items-center gap-3 rounded-[var(--radius)] px-4 py-3 text-sm font-semibold muted text-[var(--color-muted)] hover:bg-slate-50" href="#activity">◷ <span>Activity log</span></a>
      </nav>
      <div class="absolute bottom-6 left-6 right-6 rounded-[var(--radius)] bg-slate-50 p-4 soft">
        <div class="mb-2 flex items-center justify-between text-xs font-bold"><span>System health</span><span class="h-2 w-2 rounded-full bg-emerald-400"></span></div>
        <p class="text-xs leading-5 muted text-[var(--color-muted)]">REST API, SQLite and live sync are ready.</p>
      </div>
